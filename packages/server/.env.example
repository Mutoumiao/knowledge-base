# ==========================================
# GoferBot Server 专属环境变量模板
#
# 单一信息源原则：
#   - 本文件仅存放 Server-Only 变量（仅 server 应用使用）
#   - Docker-Infra 与 Shared 变量的单一信息源为根目录 .env.example
#     （DATABASE_URL / REDIS_HOST / MINIO_* / ELASTICSEARCH_* 等）
#
# 加载顺序（后加载覆盖前者同名变量）：
#   1. packages/server/.env   — Server-Only
#   2. 根目录 .env            — Docker-Infra + Shared
#
# 完整变量分类与说明见 docs/guide/backend/configuration-guide.md
# ==========================================

# ==========================================
# 服务基础配置
# 影响服务启动与全局行为
# ==========================================

# 服务端口号，Fastify 监听端口
PORT=3100

# 运行环境：development / production / test
# 影响 CORS 策略、安全头、错误详情返回、Swagger 文档开关
NODE_ENV=development

# 日志级别：debug / info / warn / error
# 生产环境建议设为 info 或 warn
LOG_LEVEL=debug

# ==========================================
# JWT 与认证安全
# 属于全局安全策略
# ==========================================

# JWT 访问令牌密钥，用于签名 access token
# 生产环境必须修改，建议执行：openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT 刷新令牌密钥，用于签名 refresh token
# 必须与 JWT_SECRET 不同，生产环境必须修改
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# JWT 访问令牌有效期
JWT_EXPIRES_IN=15m

# JWT 刷新令牌有效期
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 配置加密
# 用于加密数据库配置中心中的 API Key 等敏感信息
# ==========================================

# 配置加密密钥，强烈建议单独设置，不要复用 JWT_SECRET
# 生成方式：openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# bcrypt 密码哈希轮数，数值越大越安全但越慢
# 开发环境 10-12，生产环境 12-14
BCRYPT_SALT_ROUNDS=12

# ==========================================
# CORS 与网络安全
# ==========================================

# 前端应用地址，用于 CORS 白名单，多个来源用逗号分隔
CORS_ORIGIN=http://localhost:1420,http://localhost:1421

# SSRF 防护允许的主机名白名单
# 限制用户可配置的 Base URL 只能指向这些主机，防止内网探测
# 多个值用逗号分隔，例如：api.openai.com,api.deepseek.com
SSRF_ALLOWED_HOSTNAMES=

# ==========================================
# 队列与并发
# ==========================================

# BullMQ 任务并发数，控制同时执行的后台任务数量
QUEUE_CONCURRENCY=2

# ==========================================
# 元数据安全策略
# 限制 RAG metadata 过滤器的可用键名，防止 NoSQL 注入
# ==========================================

# 当前允许：year, status, type, category, source, language, author, priority, department, project, tags, version
METADATA_ALLOWED_KEYS=year,status,type,category,source,language,author,priority,department,project,tags,version

# ==========================================
# 实例级行为开关
# ==========================================

# 本地 Reranker 模型是否在启动时预加载
# true 时启动会变慢，但首次请求延迟更低
RERANK_EAGER_LOAD=false

# ==========================================
# 初始超级管理员账户
# 仅在首次启动且 users 表为空时自动创建
# 创建后请立即修改密码
# 注意：密码必须通过生产环境变量注入，不得在此处设置默认值
# ==========================================
SUPER_ADMIN_EMAIL=admin@goferbot.local
SUPER_ADMIN_PASSWORD=

# ==========================================
# 应用连接串，Prisma 与 pgvector 共用
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 注意：当 PostgreSQL 运行在 Docker 中时，开发环境可能需要用 127.0.0.1
#（Windows 上 Prisma engine 对 localhost 的 IPv6 解析可能与 Docker 端口映射不兼容）
# 生产环境应使用服务名或内部网络地址
DATABASE_URL=postgresql://gofer:gofer_dev_pass@127.0.0.1:5432/goferbot

# ==========================================
# 邀请码配置
# ==========================================

# 万能测试邀请码，逗号分隔多个码，可选，不入数据库
# 示例：TEST_INVITATION_CODES=TEST-CODE-001,TEST-CODE-002
TEST_INVITATION_CODES=

# ==========================================
# 验证码配置
# ==========================================

# 是否启用验证码验证，默认关闭
# 设置为 true 时，登录请求需要提供有效的验证码（白名单来源除外）
CAPTCHA_ENABLED=false

# 验证码白名单 Origin，逗号分隔多个来源，可选
# 来自这些 Origin 的登录请求将跳过验证码校验，适用于自动化测试场景
# 示例：CAPTCHA_WHITELIST_ORIGINS=http://localhost:1420,http://localhost:1421
CAPTCHA_WHITELIST_ORIGINS=
# === Observability (see docs/guide/backend/observability-ops.md) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
TRACE_SAMPLE_RATE=0.1
TRACE_FORCE_CHAT_E2E_MS=5000
TRACE_FORCE_CHAT_KA_MS=3000
TRACE_FORCE_COMPANION_E2E_MS=4000
TRACE_FORCE_COMPANION_GENERATE_MS=2500
OBS_TURN_RETENTION_DAYS=30
OBS_SLOW_TOP_N=20
OBS_SSE_EXPOSE_TRACE_ID=false
OBS_IMPLICIT_REJECT_ENABLED=true
OBS_CLEANUP_INTERVAL_MS=3600000
LANGFUSE_EXPORT_TIMEOUT_MS=3000
