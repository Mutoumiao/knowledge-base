# ==========================================
# GoferBot 根目录环境变量模板
#
# 单一信息源原则：
#   - 本文件是 Docker-Infra 与 Shared 变量的唯一信息源
#     · Docker-Infra: docker-compose.dev.yml 需要的基础设施变量
#     · Shared:       server 应用与基础设施共用的连接参数
#   - Server-Only 变量的单一信息源为 packages/server/.env.example
#     （PORT / NODE_ENV / JWT_* / CORS_ORIGIN / SSRF_ALLOWED_HOSTNAMES 等）
#   - 前端 Vite 变量的单一信息源为 packages/web/.env.example
#     与 packages/admin/.env.example
#
# 加载顺序（后加载覆盖前者同名变量）：
#   1. packages/server/.env   — Server-Only
#   2. 根目录 .env            — Docker-Infra + Shared
#
# 完整变量分类与说明见 docs/guide/backend/configuration-guide.md
# ==========================================

# ==========================================
# Docker Compose 基础设施配置
# 以下变量由 docker-compose.dev.yml 直接读取
# ==========================================

# --- PostgreSQL ---

# PostgreSQL 服务主机地址
POSTGRES_HOST=localhost

# PostgreSQL 服务监听端口，映射到宿主机
POSTGRES_PORT=5432

# PostgreSQL 初始化用户名
POSTGRES_USER=gofer

# PostgreSQL 初始化密码
POSTGRES_PASSWORD=gofer_dev_pass

# PostgreSQL 初始化数据库名
POSTGRES_DB=goferbot

# --- MinIO ---

# MinIO 服务监听端口（S3 API）
MINIO_PORT=9000

# MinIO 控制台端口
MINIO_CONSOLE_PORT=9001

# MinIO 根账号（仅用于登录 MinIO 控制台）
MINIO_ROOT_USER=minioadmin

# MinIO 根密码（仅用于登录 MinIO 控制台）
MINIO_ROOT_PASSWORD=minioadmin

# --- Redis ---

# Redis 服务端口
REDIS_PORT=6379

# ==========================================
# Shared: 应用连接基础设施的参数
# server 应用通过 ConfigModule 读取这些值
# ==========================================

# 应用连接串，Prisma 与 pgvector 共用
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 注意：当 PostgreSQL 运行在 Docker 中时，开发环境可能需要用 127.0.0.1
#（Windows 上 Prisma engine 对 localhost 的 IPv6 解析可能与 Docker 端口映射不兼容）
# 生产环境应使用服务名或内部网络地址
DATABASE_URL=postgresql://gofer:gofer_dev_pass@127.0.0.1:5432/goferbot

# 测试数据库管理连接串，用于创建/删除测试数据库，需要超级用户权限
TEST_DATABASE_ADMIN_URL=postgresql://gofer:gofer_dev_pass@127.0.0.1:5432/postgres

# Redis 服务主机地址
REDIS_HOST=localhost

# Redis 密码，无密码时留空
REDIS_PASSWORD=

# MinIO 服务端点，应用使用
MINIO_ENDPOINT=http://localhost:9000

# MinIO Access Key，应用使用
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key，应用使用
MINIO_SECRET_KEY=minioadmin

# MinIO 默认桶名，应用使用
MINIO_BUCKET=goferbot-files

# MinIO 区域
MINIO_REGION=us-east-1

# Elasticsearch 节点地址
ELASTICSEARCH_NODE=http://localhost:9200

# Elasticsearch API Key（优先使用）
ELASTICSEARCH_API_KEY=

# Elasticsearch 用户名（未使用 API Key 时生效）
ELASTICSEARCH_USERNAME=

# Elasticsearch 密码（未使用 API Key 时生效）
ELASTICSEARCH_PASSWORD=

# Elasticsearch 索引名，用于存储文档分片
ELASTICSEARCH_INDEX=knowledge_chunks

# === Knowledge AI Service（Python，仅内网） ===
# Nest → Python 调用基址（权威变量名；勿再用已废弃的 KNOWLEDGE_AI_URL）
KNOWLEDGE_AI_BASE_URL=http://127.0.0.1:8090
# 与 services/knowledge-ai-service 的 KNOWLEDGE_AI_SERVICE_TOKEN 必须一致
# 开发可用下方默认值；production 必须改为 ≥16 字符的随机强令牌（启动时会拒绝弱默认）
KNOWLEDGE_AI_SERVICE_TOKEN=dev-token-change-me
# 分层超时（毫秒）
KNOWLEDGE_AI_CONNECT_TIMEOUT_MS=15000
KNOWLEDGE_AI_GENERATION_TIMEOUT_MS=180000
# Knowledge AI 在 Docker、Nest 在宿主机时：把注入的 localhost/127.0.0.1 改写成容器可达地址
# 留空则不改写（Knowledge AI 与 Ollama 同在宿主机时）
KNOWLEDGE_AI_LOOPBACK_HOST=host.docker.internal
# Knowledge AI 容器向量列维度（须与 embedding 模型输出维一致；BGE 多为 1024）
# 在启动 knowledge compose 的环境中设置；services/knowledge-ai-service/.env 仅本机直跑 Python 时生效
EMBEDDING_DIMENSION=1024
# 容器内 Knowledge AI 环境（可选）：production 时禁用 /docs 并拒绝弱 token
# KNOWLEDGE_AI_ENVIRONMENT=development
# === Observability (dual-module M) ===
# Langfuse optional; empty = no-op export
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
TRACE_SAMPLE_RATE=0.1
TRACE_FORCE_CHAT_E2E_MS=5000
TRACE_FORCE_CHAT_KA_MS=3000
TRACE_FORCE_COMPANION_E2E_MS=4000
TRACE_FORCE_COMPANION_GENERATE_MS=2500
OBS_TURN_RETENTION_DAYS=30

# === Companion 危机资源文案（公开热线，可覆盖） ===
# 用于自伤/危机轮回复指南与硬中断错误提示；非法务承诺
# COMPANION_CRISIS_HOTLINES=希望24热线 400-161-9995；北京心理危机研究与干预中心 010-82951332

OBS_SLOW_TOP_N=20
OBS_SSE_EXPOSE_TRACE_ID=false
OBS_IMPLICIT_REJECT_ENABLED=true
OBS_CLEANUP_INTERVAL_MS=3600000
LANGFUSE_EXPORT_TIMEOUT_MS=3000
